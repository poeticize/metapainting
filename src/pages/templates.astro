---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';

const templates = [
  {
    name: 'Starter Template',
    description: 'This DNA pattern can be cut on any CNC system with the provided SVG file.',
    preview: '/paintings/coded/02-painting-1.jpg',
  },
  {
    name: 'Tree of Life',
    description: 'An organic tree design with branches, roots, and canopy regions. The masking pattern follows the natural forms, creating intuitive sections for participants.',
    preview: '/paintings/infinitree/02-painting-1.jpg',
  },
  {
    name: 'Whirled Religion',
    description: 'An elaborate and provocative statement about the state of religion in our world. Be prepared to encounter challenges when executing this in a public space.',
    preview: '/paintings/whirled-religion/02-painting-1.jpg',
  },
];
---

<Base title="Templates — MetaPainting">

  <Hero
    title="Templates"
    subtitle="Vector designs and masking patterns for your own collaborative MetaPainting projects."
    compact
    center
  />

  <section class="section">
    <div class="container">

      <div class="templates-intro reveal">
        <p class="font-serif templates-intro__text">
          These templates include vector designs and suggested masking layouts designed to work at any scale — from a small canvas at a classroom event to a massive panel at a festival.
        </p>
        <div class="templates-notice font-display">
          Downloadable templates will be available soon
        </div>
      </div>

      <div class="templates-grid">
        {templates.map(template => (
          <div class="template-card card reveal">
            <div class="template-card__preview">
              <img src={template.preview} alt={template.name} loading="lazy" decoding="async" />
            </div>
            <div class="template-card__body">
              <h3 class="template-card__name font-display">{template.name}</h3>
              <p class="template-card__desc">{template.description}</p>
              <div class="template-card__action">
                <button type="button" class="btn btn--disabled" disabled>
                  SVG Coming Soon
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="templates-note reveal">
        <p>
          <strong>Need a custom vector design?</strong> I create bespoke vector designs and CNC masking toolpaths for custom commissioned paintings.
          <a href="/contact" class="link-teal">Get in touch</a> to discuss your event.
        </p>
      </div>

    </div>
  </section>

</Base>

<style>
  .templates-intro {
    max-width: 700px;
    margin-bottom: 3rem;
  }

  .templates-intro__text {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .templates-notice {
    margin-top: 1.25rem;
    padding: 0.75rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-teal);
    border-radius: var(--radius);
    color: var(--color-teal);
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: inline-block;
  }

  .templates-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .template-card {
    display: grid;
    grid-template-columns: 300px 1fr;
    overflow: hidden;
  }

  .template-card__preview {
    overflow: hidden;
  }

  .template-card__preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .template-card:hover .template-card__preview img {
    transform: scale(1.05);
  }

  .template-card__body {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }

  .template-card__name {
    font-size: 1.6rem;
    color: var(--color-text);
    letter-spacing: 0.03em;
  }

  .template-card__desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .template-card__action {
    margin-top: 0.5rem;
  }

  .btn--disabled {
    background: var(--color-surface-2);
    color: var(--color-text-muted, #777);
    border: 1px solid var(--color-border);
    cursor: not-allowed;
    opacity: 0.7;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
  }

  .templates-note {
    margin-top: 3rem;
    padding: 1.5rem;
    background: var(--color-surface-2);
    border-radius: var(--radius);
    text-align: center;
  }

  .templates-note p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .templates-note strong {
    color: var(--color-text);
  }

  .link-teal {
    color: var(--color-teal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .link-teal:hover {
    color: var(--color-coral);
  }

  @media (max-width: 768px) {
    .template-card {
      grid-template-columns: 1fr;
    }

    .template-card__preview {
      aspect-ratio: 16 / 9;
    }
  }
</style>
