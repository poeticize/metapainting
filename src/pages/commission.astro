---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Base title="Commission — Metapainting">

  <Hero
    title="Commission a Metapainting"
    subtitle="Bring the power of collaborative art to your event, venue, or organization."
    backgroundImage="/paintings/love-and-burning/FB_20230204.jpg"
  />

  <section class="section">
    <div class="container container--narrow">

      <div class="reveal">
        <span class="section-label font-hand">Why Metapainting</span>
        <h2 class="section-title">Art That Brings People Together</h2>
        <p class="commission-intro font-serif">
          A Metapainting isn't just a painting — it's a layered experience. It begins with a
          completed work of art, which is then masked and divided into numbered sections for your
          participants to claim, peel, and paint. The result is a permanent record of a shared
          moment — artist and community fused on one surface, every participant a valid creator,
          inseparable and unique.
        </p>
      </div>

      <div class="divider"></div>

      <!-- USE CASES -->
      <div class="use-cases reveal">
        <h3 class="font-display use-cases__title">Perfect For</h3>
        <div class="use-cases__grid stagger">
          <div class="use-case">
            <h4 class="use-case__name font-display">Corporate Events</h4>
            <p>Team-building through shared creation. Nothing bonds a group like making something beautiful together.</p>
          </div>
          <div class="use-case">
            <h4 class="use-case__name font-display">Festivals & Fairs</h4>
            <p>Interactive art activation that engages thousands of attendees over the course of an event.</p>
          </div>
          <div class="use-case">
            <h4 class="use-case__name font-display">Community & Nonprofits</h4>
            <p>A physical monument to a community's shared vision, values, or milestone.</p>
          </div>
          <div class="use-case">
            <h4 class="use-case__name font-display">Private Celebrations</h4>
            <p>Weddings, anniversaries, or family reunions — create an heirloom painted by everyone who attended.</p>
          </div>
        </div>
      </div>

      <div class="divider"></div>

      <!-- WHAT'S INCLUDED -->
      <div class="included reveal">
        <h3 class="font-display included__title">What's Included</h3>
        <div class="included__list">
          <div class="included__item">
            <span class="included__check font-display">&check;</span>
            <div>
              <strong>Original Artwork & Design</strong>
              <p>Custom underpainting and vector masking cutlines tailored to your event's theme or venue.</p>
            </div>
          </div>
          <div class="included__item">
            <span class="included__check font-display">&check;</span>
            <div>
              <strong>On-Site Facilitation</strong>
              <p>Guiding participants through the process, managing paints, and ensuring seamless execution.</p>
            </div>
          </div>
          <div class="included__item">
            <span class="included__check font-display">&check;</span>
            <div>
              <strong>All Materials Provided</strong>
              <p>Paints, brushes, aprons, masking materials, UV lights, and display hardware included.</p>
            </div>
          </div>
          <div class="included__item">
            <span class="included__check font-display">&check;</span>
            <div>
              <strong>Final Finishing & Sealing</strong>
              <p>Professional clear-coat protection, UV varnish, and mounting hardware for permanent display.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="divider"></div>

      <!-- CONTACT / COMMISSION FORM -->
      <div class="commission-form-section reveal" id="form">
        <span class="section-label font-hand">Start the Conversation</span>
        <h2 class="section-title">Request a Commission</h2>
        <p class="font-serif form-subtitle">
          Tell me about your event or vision and we'll craft a custom Metapainting experience for you.
        </p>

        <ContactForm formName="commission" />
      </div>

    </div>
  </section>

</Base>

<style>
  .commission-intro {
    font-size: clamp(1.2rem, 2.5vw, 1.45rem);
    line-height: 1.7;
    color: var(--color-text);
  }

  .use-cases__title,
  .included__title {
    font-size: 1.8rem;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .use-cases__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .use-case {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 1.5rem;
    border-radius: var(--radius);
  }

  .use-case__name {
    font-size: 1.2rem;
    color: var(--color-teal);
    margin-bottom: 0.5rem;
  }

  .use-case p {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }

  .included__list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .included__item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .included__check {
    font-size: 1.4rem;
    color: var(--color-teal);
    line-height: 1;
    margin-top: 0.1rem;
  }

  .included__item strong {
    color: var(--color-text);
    font-size: 1.05rem;
  }

  .included__item p {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin-top: 0.2rem;
  }

  .form-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  @media (max-width: 600px) {
    .use-cases__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
