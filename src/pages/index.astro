---
import Base from '../layouts/Base.astro';
import PaintingCard from '../components/PaintingCard.astro';
import { getCollection } from 'astro:content';

const allPaintings = await getCollection('paintings');
const featured = allPaintings
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 4);
---

<Base title="MetaPainting — Be a Part of the Art">

  <!-- SPLASH / HERO -->
  <section class="home-hero" id="hero">
    <div class="home-hero__bg">
      <img src="/images/splash-bg.jpg" alt="" class="home-hero__img" />
    </div>
    <div class="home-hero__overlay"></div>
    <div class="home-hero__content">
      <p class="home-hero__label font-display">MetaPainting</p>
      <h1 class="home-hero__title font-display">Be a Part<br/>of the Art</h1>
      <p class="home-hero__subtitle font-serif">
        Collaborative art featuring dozens — sometimes hundreds — of participants per piece.
      </p>
      <div class="home-hero__actions">
        <a href="/gallery" class="btn btn--primary">Enter the Gallery</a>
        <a href="#about" class="btn btn--outline">Learn More</a>
      </div>
    </div>
    <div class="home-hero__scroll">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <polyline points="19 12 12 19 5 12"></polyline>
      </svg>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section" id="about">
    <div class="container">
      <div class="about reveal">
        <span class="section-label">The Vision</span>
        <h2 class="section-title">The Art of Elaborate Collaboration</h2>
        <div class="about__body">
          <p class="section-subtitle">
            Every MetaPainting begins as a completed work of art. Then it's masked, divided into
            numbered shapes, and handed to the crowd. Participants peel off a section, paint their
            contribution onto the surface, and become inseparable from the finished piece. The result
            is a layered collaboration between artist and community — dozens, sometimes hundreds of
            people — each one a valid creator in their own right.
          </p>
          <div class="divider"></div>
          <blockquote class="about__quote font-serif">
            "The notion of art conducted by individuals specialized as 'artists' in some ways denies
            the inherent artistic ability in everyone. This form gives communities artistic voice
            without the barrier of labels."
          </blockquote>
          <p class="about__credo">Art is in Us All</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats-band">
    <div class="container">
      <div class="stats stagger">
        <div class="stat">
          <span class="stat__number font-display">40+</span>
          <span class="stat__label">Paintings Created</span>
        </div>
        <div class="stat">
          <span class="stat__number font-display">1000+</span>
          <span class="stat__label">Participants</span>
        </div>
        <div class="stat">
          <span class="stat__number font-display">30+</span>
          <span class="stat__label">Layers Deep</span>
        </div>
        <div class="stat">
          <span class="stat__number font-display">&infin;</span>
          <span class="stat__label">Stories Told</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED GALLERY -->
  <section class="section" id="gallery-preview">
    <div class="container">
      <div class="reveal">
        <span class="section-label">Featured Works</span>
        <h2 class="section-title">Gallery of Wonders</h2>
        <p class="section-subtitle" style="margin-bottom: 3rem;">
          Each painting is a layered collaboration — a finished work of art, masked, divided, and
          transformed by the hands of a community.
        </p>
      </div>

      <div class="featured-grid stagger">
        {featured.map(painting => (
          <PaintingCard
            slug={painting.slug}
            title={painting.data.title}
            tagline={painting.data.tagline}
            thumbnail={painting.data.thumbnail}
            thumbnailAlt={painting.data.thumbnailAlt}
            participants={painting.data.participants}
            tags={painting.data.tags}
          />
        ))}
      </div>

      <div class="reveal" style="text-align: center; margin-top: 3rem;">
        <a href="/gallery" class="btn btn--outline">View All Works</a>
      </div>
    </div>
  </section>

  <!-- TRIPTYCH: How / Commission / Templates -->
  <section class="section">
    <div class="container">
      <div class="triptych stagger">
        <a href="/how-it-works" class="triptych__card card">
          <div class="triptych__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <h3 class="triptych__title font-display">How It Works</h3>
          <p class="triptych__desc">Learn the full MetaPainting method — from underpainting to masking to crowd collaboration.</p>
        </a>

        <a href="/commission" class="triptych__card card">
          <div class="triptych__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
          </div>
          <h3 class="triptych__title font-display">Commission a Painting</h3>
          <p class="triptych__desc">Bring the MetaPainting experience to your event, venue, or organization.</p>
        </a>

        <a href="/templates" class="triptych__card card">
          <div class="triptych__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </div>
          <h3 class="triptych__title font-display">Download Templates</h3>
          <p class="triptych__desc">Get vector files and guides to start your own collaborative painting project.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container cta-inner reveal">
      <h2 class="section-title" style="color: white;">Ready to Create Together?</h2>
      <p class="section-subtitle" style="margin-bottom: 2rem;">
        Whether you want to display, commission, or participate — let's make something extraordinary.
      </p>
      <a href="/contact" class="btn btn--primary">Get in Touch</a>
    </div>
  </section>

</Base>

<style>
  /* HERO */
  .home-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .home-hero__bg {
    position: absolute;
    inset: 0;
  }

  .home-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    animation: heroZoom 20s ease-in-out infinite alternate;
  }

  @keyframes heroZoom {
    from { transform: scale(1.05); }
    to { transform: scale(1.15); }
  }

  .home-hero__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(10, 10, 10, 0.5) 0%,
      rgba(10, 10, 10, 0.85) 100%
    );
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
    padding: 2rem;
    animation: fadeUp 1.2s ease-out;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .home-hero__label {
    font-size: 0.9rem;
    letter-spacing: 0.3em;
    color: var(--color-teal);
    margin-bottom: 1rem;
  }

  .home-hero__title {
    font-size: clamp(4rem, 12vw, 10rem);
    letter-spacing: 0.02em;
    color: white;
    line-height: 0.95;
    margin-bottom: 1.5rem;
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.5);
  }

  .home-hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.3rem);
    color: rgba(255, 255, 255, 0.7);
    max-width: 500px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  .home-hero__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .home-hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.3);
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  /* ABOUT */
  .about {
    max-width: 800px;
  }

  .about__body {
    margin-top: 1rem;
  }

  .about__quote {
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    color: var(--color-text);
    font-style: italic;
    line-height: 1.6;
    margin: 0;
  }

  .about__credo {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  /* STATS */
  .stats-band {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 3.5rem 0;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .stat__number {
    display: block;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    color: var(--color-teal);
    letter-spacing: 0.02em;
  }

  .stat__label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-top: 0.3rem;
    display: block;
  }

  @media (max-width: 600px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* FEATURED GRID */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  /* TRIPTYCH */
  .triptych {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .triptych__card {
    display: block;
    padding: 2.5rem 2rem;
    text-decoration: none;
    text-align: center;
  }

  .triptych__icon {
    color: var(--color-teal);
    margin-bottom: 1.25rem;
  }

  .triptych__title {
    font-size: 1.5rem;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    letter-spacing: 0.03em;
  }

  .triptych__desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .triptych {
      grid-template-columns: 1fr;
    }
  }

  /* CTA */
  .cta-section {
    background: linear-gradient(135deg, var(--color-teal-dim) 0%, #005050 100%);
    padding: var(--section-gap) 0;
  }

  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>
