---
interface Props {
  title: string;
  subtitle?: string;
  backgroundImage?: string;
  backgroundPosition?: string;
  compact?: boolean;
  center?: boolean;
}

const { title, subtitle, backgroundImage, backgroundPosition = 'center center', compact = false, center = false } = Astro.props;
---

<section
  class:list={['hero', { 'hero--compact': compact, 'hero--center': center, 'hero--has-bg': !!backgroundImage }]}
  style={backgroundImage ? `--bg-image: url('${backgroundImage}'); --bg-pos: ${backgroundPosition};` : undefined}
>
  {backgroundImage && <div class="hero__overlay"></div>}
  <div class="hero__content container">
    <h1 class="hero__title font-display">{title}</h1>
    {subtitle && <p class="hero__subtitle font-serif">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: flex-end;
    padding: calc(var(--nav-height) + 4rem) 0 4rem;
    background-color: var(--color-bg);
    background-image: var(--bg-image);
    background-size: cover;
    background-position: var(--bg-pos, center);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .hero--compact {
    min-height: auto;
    padding: calc(var(--nav-height) + 3rem) 0 3rem;
  }

  .hero--center {
    align-items: center;
    text-align: center;
  }

  .hero--center .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(28, 25, 23, 0.92) 0%,
      rgba(28, 25, 23, 0.65) 50%,
      rgba(28, 25, 23, 0.4) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
  }

  .hero--has-bg .hero__title {
    color: #ffffff;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .hero--has-bg .hero__subtitle {
    color: rgba(255, 255, 255, 0.85);
  }

  .hero--has-bg .btn--outline {
    border-color: rgba(255, 255, 255, 0.8);
    color: #ffffff;
  }

  .hero--has-bg .btn--outline:hover {
    background: #ffffff;
    border-color: #ffffff;
    color: #1c1917;
  }

  .hero__title {
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1.05;
  }

  .hero__subtitle {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    color: var(--color-text-secondary);
    max-width: 650px;
    line-height: 1.6;
  }
</style>
