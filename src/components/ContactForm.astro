---
interface Props {
  formName?: string;
}

const { formName = 'contact' } = Astro.props;
---

<div class="contact-form-wrapper">
  <form
    class="contact-form"
    id="ajax-contact-form"
    method="POST"
  >
    <!-- Web3Forms Access Key: Replace with your free key from https://web3forms.com -->
    <input type="hidden" name="access_key" value="4d4e339d-2309-4676-9d33-4f958f0dd871" id="web3forms-key" />
    <input type="hidden" name="subject" value="New Inquiry from MetaPainting.net" />
    <input type="hidden" name="from_name" value="MetaPainting Contact Form" />

    <div class="contact-form__row">
      <div class="form-field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required placeholder="Your name" autocomplete="name" />
      </div>
      <div class="form-field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com" autocomplete="email" />
      </div>
    </div>

    <div class="form-field">
      <label for="inquiry">I'm Interested In</label>
      <select id="inquiry" name="inquiry">
        <option value="General Inquiry">General Inquiry</option>
        <option value="Commissioning a Painting">Commissioning a Painting</option>
        <option value="Displaying Work at My Venue">Displaying Work at My Venue</option>
        <option value="Purchasing a Painting">Purchasing a Painting</option>
        <option value="Collaboration / Partnership">Collaboration / Partnership</option>
      </select>
    </div>

    <div class="form-field">
      <label for="message">Message</label>
      <textarea id="message" name="message" required placeholder="Tell me about your vision..."></textarea>
    </div>

    <button type="submit" class="btn btn--primary" id="contact-submit-btn">
      <span class="btn-text">Send Message</span>
      <span class="btn-loader" style="display: none;">Sending...</span>
    </button>
  </form>

  <div class="contact-success card" id="contact-success-box" style="display: none;">
    <div class="contact-success__inner">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-teal)" stroke-width="2">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
      <h3 class="font-display">Message Sent!</h3>
      <p class="font-serif">
        Thank you for reaching out. Your message has been sent directly to <strong>poeticize@gmail.com</strong>. I'll get back to you soon!
      </p>
      <button type="button" id="reset-contact-form-btn" class="btn btn--outline" style="margin-top: 1rem;">
        Send Another Message
      </button>
    </div>
  </div>
</div>

<style>
  .contact-form-wrapper {
    max-width: 700px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .contact-success {
    padding: 3rem 2rem;
    text-align: center;
    background: var(--color-surface-2);
    border: 1.5px solid var(--color-teal);
    border-radius: var(--radius-lg);
  }

  .contact-success__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .contact-success h3 {
    font-size: 2rem;
    color: var(--color-text);
    margin: 0;
  }

  .contact-success p {
    color: var(--color-text-secondary);
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0;
  }

  @media (max-width: 600px) {
    .contact-form__row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById('ajax-contact-form') as HTMLFormElement;
    const successBox = document.getElementById('contact-success-box') as HTMLElement;
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement;
    const btnText = submitBtn?.querySelector('.btn-text') as HTMLElement;
    const btnLoader = submitBtn?.querySelector('.btn-loader') as HTMLElement;
    const resetBtn = document.getElementById('reset-contact-form-btn') as HTMLButtonElement;

    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.style.display = 'none';
      if (btnLoader) btnLoader.style.display = 'inline';

      const formData = new FormData(form);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();

        if (result.success) {
          form.style.display = 'none';
          form.reset();
          if (successBox) successBox.style.display = 'block';
        } else {
          alert('Submission failed: ' + (result.message || 'Please try again.'));
        }
      } catch (err) {
        alert('Network error submitting message. Please try again.');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.style.display = 'inline';
        if (btnLoader) btnLoader.style.display = 'none';
      }
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (successBox) successBox.style.display = 'none';
        form.style.display = 'flex';
      });
    }
  }

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
  document.addEventListener('DOMContentLoaded', initContactForm);
</script>
