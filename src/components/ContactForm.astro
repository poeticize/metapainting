---
interface Props {
  formName?: string;
}

const { formName = 'contact' } = Astro.props;
---

<div class="contact-form-wrapper">
  <form
    class="contact-form"
    id="direct-contact-form"
    onsubmit="return false;"
  >
    <div class="contact-form__row">
      <div class="form-field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required placeholder="Your name" autocomplete="name" />
      </div>
      <div class="form-field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com" autocomplete="email" />
      </div>
    </div>

    <div class="form-field">
      <label for="inquiry">I'm Interested In</label>
      <select id="inquiry" name="inquiry">
        <option value="General Inquiry">General Inquiry</option>
        <option value="Commissioning a Painting">Commissioning a Painting</option>
        <option value="Displaying Work at My Venue">Displaying Work at My Venue</option>
        <option value="Purchasing a Painting">Purchasing a Painting</option>
        <option value="Collaboration / Partnership">Collaboration / Partnership</option>
      </select>
    </div>

    <div class="form-field">
      <label for="message">Message</label>
      <textarea id="message" name="message" required placeholder="Tell me about your vision..."></textarea>
    </div>

    <button type="submit" class="btn btn--primary" id="contact-submit-btn">Send Message</button>
  </form>

  <div class="contact-success card" id="contact-success-box" style="display: none;">
    <div class="contact-success__inner">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-teal)" stroke-width="2">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
      <h3 class="font-display">Message Sent / Prepared!</h3>
      <p class="font-serif" id="contact-success-desc">
        Your inquiry for <strong>poeticize@gmail.com</strong> has been prepared. Click below to open your email application.
      </p>
      <div class="contact-success__actions">
        <a id="fallback-email-link" href="mailto:poeticize@gmail.com" class="btn btn--primary">
          Open Email App &rarr;
        </a>
        <button type="button" id="reset-contact-form-btn" class="btn btn--outline" style="margin-top: 0.5rem;">
          Send Another Message
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .contact-form-wrapper {
    max-width: 700px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .contact-success {
    padding: 3rem 2rem;
    text-align: center;
    background: var(--color-surface-2);
    border: 1.5px solid var(--color-teal);
    border-radius: var(--radius-lg);
  }

  .contact-success__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .contact-success h3 {
    font-size: 2rem;
    color: var(--color-text);
    margin: 0;
  }

  .contact-success p {
    color: var(--color-text-secondary);
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0;
  }

  .contact-success__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 600px) {
    .contact-form__row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById('direct-contact-form') as HTMLFormElement;
    const successBox = document.getElementById('contact-success-box') as HTMLElement;
    const fallbackLink = document.getElementById('fallback-email-link') as HTMLAnchorElement;
    const resetBtn = document.getElementById('reset-contact-form-btn') as HTMLButtonElement;

    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = (document.getElementById('name') as HTMLInputElement)?.value || '';
      const email = (document.getElementById('email') as HTMLInputElement)?.value || '';
      const inquiry = (document.getElementById('inquiry') as HTMLSelectElement)?.value || '';
      const message = (document.getElementById('message') as HTMLTextAreaElement)?.value || '';

      const subject = encodeURIComponent(`MetaPainting Inquiry: ${inquiry} from ${name}`);
      const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nInquiry: ${inquiry}\n\nMessage:\n${message}`);

      const mailtoUrl = `mailto:poeticize@gmail.com?subject=${subject}&body=${body}`;

      if (fallbackLink) {
        fallbackLink.href = mailtoUrl;
      }

      // Hide form, reset inputs, display success box
      form.style.display = 'none';
      form.reset();

      if (successBox) {
        successBox.style.display = 'block';
      }

      // Trigger mailto link directly via window.open / location
      window.location.href = mailtoUrl;
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (successBox) successBox.style.display = 'none';
        form.style.display = 'flex';
      });
    }
  }

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
  document.addEventListener('DOMContentLoaded', initContactForm);
</script>
