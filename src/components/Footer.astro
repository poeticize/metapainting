---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__top">
      <div class="footer__brand">
        <span class="footer__logo font-display">Metapainting</span>
        <p class="footer__tagline font-serif">Be a Part of the Art</p>
      </div>
      <nav class="footer__nav">
        <div class="footer__col">
          <h4 class="footer__heading">Explore</h4>
          <a href="/gallery">Gallery</a>
          <a href="/how-it-works">How It Works</a>
          <a href="/templates">Templates</a>
        </div>
        <div class="footer__col">
          <h4 class="footer__heading">Connect</h4>
          <a href="/commission">Commission a Painting</a>
          <a href="/contact">Get in Touch</a>
        </div>
      </nav>
    </div>
    <div class="footer__bottom">
      <p>&copy; {year} Metapainting. All proceeds support the expansion of collaborative art.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: 4rem 0 2rem;
    margin-top: var(--section-gap);
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .footer__logo {
    font-size: 1.8rem;
    letter-spacing: 0.04em;
    color: var(--color-text);
  }

  .footer__tagline {
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: 0.3rem;
    font-size: 1rem;
  }

  .footer__nav {
    display: flex;
    gap: 4rem;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer__heading {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
  }

  .footer__col a {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .footer__col a:hover {
    color: var(--color-teal);
  }

  .footer__bottom {
    padding-top: 2rem;
  }

  .footer__bottom p {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .footer__nav {
      flex-direction: column;
      gap: 2rem;
    }
  }
</style>
