---
interface Props {
  slug: string;
  title: string;
  tagline: string;
  thumbnail: string;
  thumbnailAlt?: string;
  participants?: number;
  tags?: string[];
}

const { slug, title, tagline, thumbnail, thumbnailAlt, participants, tags = [] } = Astro.props;
---

<a href={`/paintings/${slug}`} class="gallery-card card" data-tags={tags.join(',')}>
  <div class="gallery-card__image-wrap">
    <img
      class="gallery-card__image gallery-card__image--light"
      src={thumbnail}
      alt={title}
      loading="lazy"
      decoding="async"
    />
    {thumbnailAlt && (
      <img
        class="gallery-card__image gallery-card__image--alt"
        src={thumbnailAlt}
        alt={`${title} — alternate view`}
        loading="lazy"
        decoding="async"
      />
    )}
  </div>
  <div class="gallery-card__info">
    <h3 class="gallery-card__title font-display">{title}</h3>
    <p class="gallery-card__tagline">{tagline}</p>
    {participants && (
      <span class="gallery-card__meta">{participants} participants</span>
    )}
  </div>
</a>

<style>
  .gallery-card {
    display: block;
    text-decoration: none;
  }

  .gallery-card__image-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .gallery-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gallery-card:hover .gallery-card__image {
    transform: scale(1.05);
  }

  .gallery-card__image--alt {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--transition-base), transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(body.blacklight) .gallery-card__image--alt {
    opacity: 1;
  }

  .gallery-card__info {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .gallery-card__title {
    font-size: 1.6rem;
    letter-spacing: 0.03em;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .gallery-card__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }

  .gallery-card__meta {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-teal);
  }
</style>
