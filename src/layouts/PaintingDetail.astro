---
import Base from './Base.astro';
import PhaseTimeline from '../components/PhaseTimeline.astro';
import LayerSlider from '../components/LayerSlider.astro';
import LightboxModal from '../components/LightboxModal.astro';

interface Props {
  title: string;
  tagline: string;
  slug: string;
  participants?: number;
  date?: string;
  venue?: string;
  medium?: string;
  dimensions?: string;
  thumbnail: string;
  photoAlbumUrl?: string;
  hasBlacklight?: boolean;
  reverberationNotes?: string;
  collaboratorHighlight?: string[];
  layers?: {
    underpainting?: string;
    masking?: string;
    complete?: string;
    blacklight?: string;
  };
  phases: {
    label: string;
    description: string;
    images: string[];
  }[];
  prevPainting?: { slug: string; title: string } | null;
  nextPainting?: { slug: string; title: string } | null;
}

const {
  title,
  tagline,
  slug,
  participants,
  date,
  venue,
  medium,
  dimensions,
  thumbnail,
  photoAlbumUrl,
  hasBlacklight,
  reverberationNotes,
  collaboratorHighlight = [],
  layers,
  phases = [],
  prevPainting,
  nextPainting,
} = Astro.props;

const basePath = `/paintings/${slug}`;

function getLayerSrc(explicitSrc?: string, phaseSnippet?: string) {
  if (explicitSrc) {
    return explicitSrc.startsWith('/') ? explicitSrc : `${basePath}/${explicitSrc}`;
  }
  if (!phaseSnippet) return undefined;
  const match = phases.find(p => p.label.toLowerCase().includes(phaseSnippet));
  if (match && match.images.length > 0) {
    const img = match.images[0];
    return img.startsWith('/') ? img : `${basePath}/${img}`;
  }
  return undefined;
}

const resolvedLayers = {
  underpainting: getLayerSrc(layers?.underpainting, 'painting'),
  masking: getLayerSrc(layers?.masking, 'mask'),
  complete: getLayerSrc(layers?.complete, 'complete') || (thumbnail.startsWith('/') ? thumbnail : `${basePath}/${thumbnail}`),
  blacklight: getLayerSrc(layers?.blacklight, 'effect') || getLayerSrc(layers?.blacklight, 'blacklight'),
};
---

<Base title={`${title} — MetaPainting`} ogImage={thumbnail}>

  <section class="painting-hero" style={`--bg: url('${thumbnail}')`}>
    <div class="painting-hero__overlay"></div>
    <div class="painting-hero__content container">
      <a href="/gallery" class="painting-hero__back btn--ghost">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Gallery
      </a>
      <h1 class="painting-hero__title font-display">{title}</h1>
      <p class="painting-hero__tagline font-serif">{tagline}</p>

      <div class="painting-hero__meta">
        {participants && <span class="meta-pill">{participants} Participants</span>}
        {date && <span class="meta-pill">{date}</span>}
        {medium && <span class="meta-pill">{medium}</span>}
        {venue && <span class="meta-pill">{venue}</span>}
        {dimensions && <span class="meta-pill">{dimensions}</span>}
        {hasBlacklight && <span class="meta-pill meta-pill--uv">UV Reactive</span>}
        {photoAlbumUrl && (
          <a href={photoAlbumUrl} target="_blank" rel="noopener noreferrer" class="painting-hero__album-link btn--outline">
            Full Google Photos Album &rarr;
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="painting-body section container">
    <!-- Interactive Layer Comparison Slider -->
    <LayerSlider
      title={title}
      underpainting={resolvedLayers.underpainting}
      underpaintingLabel={layers?.underpaintingLabel}
      masking={resolvedLayers.masking}
      maskingLabel={layers?.maskingLabel}
      complete={resolvedLayers.complete}
      completeLabel={layers?.completeLabel}
      blacklight={resolvedLayers.blacklight}
      blacklightLabel={layers?.blacklightLabel}
    />

    <!-- Narrative & Prose Body -->
    <div class="painting-prose">
      <slot />
    </div>

    <!-- Collaborator & Reverberation Highlights -->
    {reverberationNotes && (
      <div class="reverberation-box card">
        <h4 class="font-display reverberation-title">Residual Reverberation</h4>
        <p class="font-serif">{reverberationNotes}</p>
      </div>
    )}

    {collaboratorHighlight.length > 0 && (
      <div class="highlights-box card">
        <h4 class="font-display reverberation-title">Participant & Process Reflections</h4>
        <ul>
          {collaboratorHighlight.map(item => (
            <li class="font-serif">"{item}"</li>
          ))}
        </ul>
      </div>
    )}

    <!-- Creation Timeline -->
    <div class="timeline-header">
      <span class="section-label">Chronological Process</span>
      <h2 class="font-display section-title">Creation & Event Lifecycle</h2>
    </div>

    <PhaseTimeline phases={phases} paintingSlug={slug} />
  </section>

  <nav class="painting-nav container">
    <div class="painting-nav__inner">
      {prevPainting ? (
        <a href={`/paintings/${prevPainting.slug}`} class="painting-nav__link painting-nav__link--prev">
          <span class="painting-nav__label">Previous Painting</span>
          <span class="painting-nav__name font-display">{prevPainting.title}</span>
        </a>
      ) : <div />}
      {nextPainting ? (
        <a href={`/paintings/${nextPainting.slug}`} class="painting-nav__link painting-nav__link--next">
          <span class="painting-nav__label">Next Painting</span>
          <span class="painting-nav__name font-display">{nextPainting.title}</span>
        </a>
      ) : <div />}
    </div>
  </nav>

  <!-- Lightbox Modal Triggered by any process photo -->
  <LightboxModal />

</Base>

<style>
  .painting-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    background-image: var(--bg);
    background-size: cover;
    background-position: center;
    padding-bottom: 4rem;
  }

  .painting-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 10, 10, 1) 0%,
      rgba(10, 10, 10, 0.75) 40%,
      rgba(10, 10, 10, 0.25) 100%
    );
  }

  .painting-hero__content {
    position: relative;
    z-index: 1;
  }

  .painting-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    transition: color var(--transition-fast);
  }

  .painting-hero__back:hover {
    color: var(--color-teal);
  }

  .painting-hero__title {
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    letter-spacing: 0.02em;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .painting-hero__tagline {
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    color: var(--color-text-secondary);
    font-style: italic;
    margin-bottom: 2rem;
    max-width: 800px;
  }

  .painting-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .meta-pill {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-teal);
    background: rgba(45, 212, 168, 0.1);
    border: 1px solid rgba(45, 212, 168, 0.25);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
  }

  .meta-pill--uv {
    color: var(--color-violet);
    background: rgba(188, 19, 254, 0.1);
    border-color: rgba(188, 19, 254, 0.3);
  }

  .painting-hero__album-link {
    padding: 0.4rem 1.25rem;
    font-size: 0.8rem;
  }

  .painting-body {
    max-width: 1000px;
  }

  .painting-prose {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.85;
    color: var(--color-text-secondary);
    margin: 3rem 0;
    max-width: 800px;
  }

  .reverberation-box, .highlights-box {
    padding: 2rem;
    margin: 2.5rem 0;
    border-left: 4px solid var(--color-violet);
    background: var(--color-surface);
  }

  .highlights-box {
    border-left-color: var(--color-teal);
  }

  .reverberation-title {
    font-size: 1.5rem;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .highlights-box ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .highlights-box li {
    font-style: italic;
    color: var(--color-text-secondary);
  }

  .timeline-header {
    margin-top: 5rem;
    margin-bottom: 2.5rem;
  }

  .painting-nav {
    padding: 3rem 0;
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
  }

  .painting-nav__inner {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .painting-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    transition: color var(--transition-fast);
  }

  .painting-nav__link--next {
    text-align: right;
    margin-left: auto;
  }

  .painting-nav__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .painting-nav__name {
    font-size: 1.5rem;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .painting-nav__link:hover .painting-nav__name {
    color: var(--color-teal);
  }
</style>
